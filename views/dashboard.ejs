    <!-- ============================== 12. DSA TRACKER (ENHANCED) ============================== -->
    <section class="section" id="dsa">
      <div class="section-title">
        <span class="icon">💻</span> DSA Tracker
        <span class="hint">🔥 DSA streak · <%= dsaStreak %> · <%= dsaCount %> problems total</span>
      </div>

      <!-- Unaided stats -->
      <% if (dsaUnaided) { %>
      <div class="unaided-stats-card card">
        <div class="unaided-row">
          <span class="hl-badge hl-badge--alone">🟢 Alone: <%= dsaUnaided.alone %></span>
          <span class="hl-badge hl-badge--hint">🟡 Hint: <%= dsaUnaided.hint %></span>
          <span class="hl-badge hl-badge--copilot">🟠 Copilot: <%= dsaUnaided.copilot %></span>
          <span class="unaided-percent-badge">Unaided: <strong><%= dsaUnaided.percent %>%</strong></span>
        </div>
        <div class="progress-wrap unaided-progress">
          <div class="progress-bar" style="width:<%= dsaUnaided.percent %>%"></div>
        </div>
      </div>
      <% } %>

      <div class="card mt">
        <div class="card-title">Add a Problem</div>
        <form id="dsa-form">
          <div class="grid cols-2">
            <div class="field">
              <label for="dsa-name">Problem Name</label>
              <input class="input" type="text" id="dsa-name" name="name" placeholder="e.g. Two Sum" required />
            </div>
            <div class="field">
              <label for="dsa-pattern">Pattern</label>
              <input class="input" type="text" id="dsa-pattern" name="pattern" placeholder="e.g. Hash Map, Two Pointers" />
            </div>
            <div class="field">
              <label for="dsa-difficulty">Difficulty</label>
              <select class="select" id="dsa-difficulty" name="difficulty">
                <option value="easy">Easy</option>
                <option value="medium">Medium</option>
                <option value="hard">Hard</option>
              </select>
            </div>
            <div class="field">
              <label for="dsa-time">Time (minutes)</label>
              <input class="input" type="number" id="dsa-time" name="time" min="0" max="600" placeholder="e.g. 25" />
            </div>
            <div class="field">
              <label for="dsa-help-level">Help Level</label>
              <select class="select" id="dsa-help-level" name="help_level">
                <option value="alone">🟢 Alone — solo solve</option>
                <option value="hint">🟡 Hint — got a nudge</option>
                <option value="copilot">🟠 Copilot — AI assisted</option>
              </select>
            </div>
            <div class="field">
              <label for="dsa-needed-help">Needed Help? (legacy)</label>
              <select class="select" id="dsa-needed-help" name="needed_help">
                <option value="false">No — solo solve</option>
                <option value="true">Yes — got hints</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="dsa-notes">Notes</label>
            <textarea class="textarea" id="dsa-notes" name="notes" placeholder="What did you learn? Any trick to revisit?"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            <span class="btn-label">+ Log Problem</span>
          </button>
        </form>
      </div>

      <div class="card mt">
        <div class="card-title">Recent Problems</div>
        <div class="problem-list" id="dsa-list">
          <% if (recentDsa && recentDsa.length) { %>
            <% recentDsa.forEach(function(p){ %>
              <div class="problem-item">
                <div class="p-name"><%= p.name %></div>
                <div class="p-meta">
                  <% if (p.pattern) { %><span>📐 <%= p.pattern %></span><% } %>
                  <span class="diff-<%= p.difficulty || 'easy' %>"><%= (p.difficulty || 'easy').toUpperCase() %></span>
                  <% if (p.time) { %><span>⏱ <%= p.time %> min</span><% } %>
                  <% if (p.help_level) { %>
                    <span class="hl-badge hl-badge--<%= p.help_level %>"><%= p.help_level %></span>
                  <% } else if (p.needed_help) { %>
                    <span>💡 needed help</span>
                  <% } %>
                </div>
                <% if (p.notes) { %><div class="p-notes"><%= p.notes %></div><% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">No problems logged today. Add your first one above ↑</div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- ============================== 13. JOURNAL ============================== -->
    <section class="section" id="journal">
      <div class="section-title">
        <span class="icon">📝</span> Daily Journal
        <span class="hint">Brain dump · wins · targets</span>
      </div>
      <div class="card">
        <form id="journal-form">
          <div class="field">
            <label for="j-brain">Brain Dump 🧠</label>
            <textarea class="textarea" id="j-brain" name="brain_dump" placeholder="Empty your head here — whatever's on your mind..."></textarea>
          </div>
          <div class="grid cols-2">
            <div class="field">
              <label for="j-wins">3 Wins 🏆</label>
              <textarea class="textarea" id="j-wins" name="three_wins" placeholder="1. ...&#10;2. ...&#10;3. ..."></textarea>
            </div>
            <div class="field">
              <label for="j-targets">3 Targets 🎯</label>
              <textarea class="textarea" id="j-targets" name="three_targets" placeholder="1. ...&#10;2. ...&#10;3. ..."></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn-gold">
            <span class="btn-label">💾 Save Journal</span>
          </button>
        </form>
      </div>

      <div class="card mt">
        <div class="card-title">Today's Entries</div>
        <div class="problem-list" id="journal-list">
          <% if (journal && journal.length) { %>
            <% journal.forEach(function(entry){ %>
              <div class="problem-item">
                <div class="p-name"><%= entry.entry_type.replace(/_/g,' ') %></div>
                <div class="p-meta">
                  <span><%= new Date(entry.date).toLocaleString('en-US', { hour:'2-digit', minute:'2-digit' }) %></span>
                </div>
                <div class="p-notes"><%= entry.content %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">No journal entries yet today.</div>
          <% } %>
