<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Command Center · Day <%= activeDayCount %> of 84</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- ============================== HERO ============================== -->
  <header class="app-header">
    <div class="container">
      <div class="row row-wrap" style="justify-content:space-between;">
        <div>
          <div class="greeting">Bismillah, <span class="accent"><%= user.username %></span> 🌙</div>
          <div class="date-line"><%= today.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %></div>
        </div>
        <a class="logout-link" href="/logout">Sign out</a>
      </div>
      <div class="mt">
        <div class="progress-label">
          <span>12-Week Journey · Day <%= activeDayCount %> of 84</span>
          <span class="pct"><%= Math.round((activeDayCount / 84) * 100) %>%</span>
        </div>
        <div class="progress-wrap"><div class="progress-bar" style="width:<%= Math.min(100, (activeDayCount / 84) * 100) %>%"></div></div>
      </div>
      <div class="streak-badges header-streaks mt">
        <span class="streak-badge salah"><span class="fire">🔥</span> Salah · <%= salahStreak %></span>
        <span class="streak-badge dsa"><span class="fire">🔥</span> DSA · <%= dsaStreak %></span>
        <span class="streak-badge survival"><span class="fire">🔥</span> Survival · <%= survivalStreak %></span>
        <span class="streak-badge" style="border-color:var(--gold-bd);color:var(--gold)">📊 Focus · <%= focusScore %>%</span>
        <span class="streak-badge" style="border-color:var(--emerald-bd);color:var(--emerald)">🎯 <%= milestoneNext.icon %> <%= milestoneNext.pct %>%</span>
      </div>
      <div class="week-stats mt">
        <div class="week-stat"><div class="ws-num"><%= weekStats.salah_complete_days || 0 %></div><div class="ws-label">Salah</div></div>
        <div class="week-stat"><div class="ws-num"><%= weekStats.dsa_days || 0 %></div><div class="ws-label">DSA</div></div>
        <div class="week-stat"><div class="ws-num"><%= weekStats.mma_days || 0 %></div><div class="ws-label">MMA</div></div>
        <div class="week-stat"><div class="ws-num"><%= weekStats.active_days || 0 %></div><div class="ws-label">Active</div></div>
        <div class="week-stat"><div class="ws-num"><%= weekStats.total_days || 0 %></div><div class="ws-label">Total/7</div></div>
      </div>
    </div>
  </header>

  <!-- ============================== TAB NAV ============================== -->
  <nav class="tab-nav" id="tabNav">
    <div class="container">
      <div class="tab-bar">
        <button class="tab-btn active" data-tab="dashboard">📊 Dashboard</button>
        <button class="tab-btn" data-tab="progress">📈 Progress</button>
        <button class="tab-btn" data-tab="journal">📝 Journal</button>
        <button class="tab-btn" data-tab="settings">⚙️ Settings</button>
      </div>
    </div>
  </nav>

  <main class="container">

    <!-- ============================== TAB: DASHBOARD ============================== -->
    <div class="tab-content active" id="tab-dashboard">

      <!-- TRAJECTORY -->
      <section class="section">
        <div class="section-title"><span class="icon">📈</span> Trajectory & Projection</div>
        <div class="grid cols-3">
          <div class="card proj-card">
            <div class="proj-label">Current Pace</div>
            <div class="proj-value"><%= projection.pace %> <span class="proj-unit">DSA/day</span></div>
          </div>
          <div class="card proj-card">
            <div class="proj-label">Projected Finish</div>
            <div class="proj-value">Day <%= projection.projectedFinishDays %></div>
            <div class="progress-wrap mt" style="height:8px;">
              <div class="progress-bar" style="width:<%= Math.min(100, (projection.projectedFinishDays / 84) * 100) %>%"></div>
            </div>
          </div>
          <div class="card proj-card <%= projection.restBudget < 0 ? 'proj-danger' : 'proj-ok' %>">
            <div class="proj-label">Rest Day Budget</div>
            <div class="proj-value"><%= projection.restBudget > 0 ? projection.restBudget + ' days' : '⚠️ Over!' %></div>
          </div>
        </div>
        <% if (projection.needToSpeedUp) { %>
          <div class="card mt proj-danger-card">⚠️ <strong>Need to speed up.</strong> At current pace you'll finish on Day <%= projection.projectedFinishDays %>. Increase DSA/day to finish on time.</div>
        <% } else { %>
          <div class="card mt proj-ok-card">✅ On track. <%= projection.restBudget %> rest days available. You can afford a break.</div>
        <% } %>
      </section>

      <!-- MILESTONE -->
      <section class="section">
        <div class="section-title"><span class="icon"><%= milestoneNext.icon %></span> Next Milestone</div>
        <div class="card milestone-card">
          <div class="row" style="align-items:center;gap:16px;">
            <div class="milestone-ring" style="--pct:<%= milestoneNext.pct %>">
              <span class="mr-num"><%= milestoneNext.pct %>%</span>
            </div>
            <div>
              <div class="milestone-name"><%= milestoneNext.icon %> <%= milestoneNext.name %></div>
              <div class="milestone-desc"><%= milestoneNext.label %> · <%= milestoneNext.current %>/<%= milestoneNext.threshold %></div>
            </div>
          </div>
        </div>
      </section>

      <!-- TODAY'S PLAN -->
      <section class="section">
        <div class="section-title"><span class="icon">📋</span> Today's Plan</div>
        <div class="card">
          <div class="plan-bars">
            <div class="plan-bar">🟢 <strong>Low:</strong> 1 DSA + 1 concept + 1 career action</div>
            <div class="plan-bar">🟡 <strong>High:</strong> 4 DSA + full Spring Boot + full career</div>
          </div>
          <% if (todayPlan && todayPlan.dsa && todayPlan.dsa.length) { %>
            <div class="mt plan-list"><strong>DSA:</strong>
              <% todayPlan.dsa.forEach(function(p){ %><span class="plan-chip"><%= p %></span><% }); %>
            </div>
          <% } %>
          <% if (todayPlan && todayPlan.spring_boot) { %><div class="mt plan-list"><strong>Spring Boot:</strong> <%= todayPlan.spring_boot %></div><% } %>
          <% if (todayPlan && todayPlan.system_design) { %><div class="mt plan-list"><strong>System Design:</strong> <%= todayPlan.system_design %></div><% } %>
          <% if (todayPlan && todayPlan.career) { %><div class="mt plan-list"><strong>Career:</strong> <%= todayPlan.career %></div><% } %>
          <% if (todayPlan && todayPlan.devops) { %><div class="mt plan-list"><strong>DevOps:</strong> <%= todayPlan.devops %></div><% } %>
        </div>
      </section>

      <!-- OVERDUE -->
      <% if (overdueRevisions && overdueRevisions.length) { %>
      <section class="section">
        <div class="section-title"><span class="icon">⚠️</span> Overdue Revisions</div>
        <div class="card overdue-card">
          <% overdueRevisions.forEach(function(r){ %>
            <div class="overdue-item">🔴 <%= r.problem %> — <span class="text-mute"><%= r.days_overdue %>d overdue</span></div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- SURVIVAL LAYER -->
      <section class="section" id="survival">
        <div class="section-title"><span class="icon">🌅</span> Survival Layer</div>
        <div class="grid cols-3">
          <% ['survival_layer:⏰:Alarm & Out','tahajjud:🌌:Tahajjud','fajr:🕌:Fajr','duha:☀️:Adhkar & Duha','fasting:🌑:Fasting'].forEach(function(item){ var p=item.split(':'); %>
            <div class="toggle-card" data-field="<%= p[0] %>" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress[p[0]] %>">
              <div class="tc-head"><span class="tc-icon"><%= p[1] %></span><span class="tc-label"><%= p[2] %></span><span class="tc-check"></span></div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- SALAH -->
      <section class="section" id="salah">
        <div class="section-title"><span class="icon">🕌</span> Salah Tracker <span class="hint">🔥 <%= salahStreak %></span></div>
        <div class="celebrate" id="salah-celebrate"><span class="emoji">🎉</span><span>All 5 prayers complete! MashaAllah!</span></div>
        <div class="grid cols-4">
          <% ['fajr:🌅:Fajr','dhuhr:🌞:Dhuhr','asr:🌇:Asr','maghrib:🌆:Maghrib','isha:🌙:Isha'].forEach(function(item){ var p=item.split(':'); %>
            <div class="toggle-card" data-field="<%= p[0] %>" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress[p[0]] %>">
              <div class="tc-head"><span class="tc-icon"><%= p[1] %></span><span class="tc-label"><%= p[2] %></span><span class="tc-check"></span></div>
            </div>
          <% }); %>
          <% if (today.getDay() === 5) { %>
            <div class="toggle-card" data-field="jumuah" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.jumuah %>">
              <div class="tc-head"><span class="tc-icon">🕋</span><span class="tc-label">Jumu'ah</span><span class="tc-check"></span></div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- PRIME + TRAINING -->
      <section class="section">
        <div class="section-title"><span class="icon">📖</span> Prime & Training</div>
        <div class="grid cols-3">
          <% ['morning_reading:📚:Morning Reading','targets_set:🎯:Targets Set','house_task:🏠:House Task','mma:🥊:MMA Session','post_workout_meal:🍗:Post-Workout Meal','shower:🚿:Shower'].forEach(function(item){ var p=item.split(':'); %>
            <div class="toggle-card" data-field="<%= p[0] %>" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress[p[0]] %>">
              <div class="tc-head"><span class="tc-icon"><%= p[1] %></span><span class="tc-label"><%= p[2] %></span><span class="tc-check"></span></div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- LEARNING BLOCKS -->
      <section class="section" id="blocks">
        <div class="section-title"><span class="icon">🧠</span> Learning Blocks</div>
        <div class="grid cols-4">
          <% ['block1_done:🟢:Block 1:DSA','block2_done:🔵:Block 2:Spring Boot','block3_done:🟣:Block 3:Sys Design','block4_done:🟡:Block 4:Revision'].forEach(function(item){ var p=item.split(':'); %>
            <div class="toggle-card" data-field="<%= p[0] %>" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress[p[0]] %>">
              <div class="tc-head"><span class="tc-icon"><%= p[1] %></span><span class="tc-label"><%= p[2] %></span><span class="tc-check"></span></div>
              <div class="tc-sub"><%= p[3] %></div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- SHIELDS -->
      <section class="section" id="shields">
        <div class="section-title"><span class="icon">🛡️</span> Shields</div>
        <div class="grid cols-3">
          <% ['ghusl_rule:🛡️:Ghusl Rule','khalwah_shield:🛡️:Khalwah Shield','night_protocol:🛡️:Night Protocol','phone_out_of_bedroom:🛡️:Phone Out','lower_gaze:🛡️:Lower Gaze','no_new_riba:🛡️:No New Riba'].forEach(function(item){ var p=item.split(':'); %>
            <div class="toggle-card" data-field="<%= p[0] %>" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress[p[0]] %>">
              <div class="tc-head"><span class="tc-icon"><%= p[1] %></span><span class="tc-label"><%= p[2] %></span><span class="tc-check"></span></div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- EVENING RESET -->
      <section class="section" id="evening">
        <div class="section-title"><span class="icon">🌙</span> Evening Reset</div>
        <div class="grid cols-3">
          <% ['haldi_doodh:🥛:Haldi Doodh','sleep_on_wudu:💧:Sleep on Wudu','evening_reset:✅:Evening Reset Done'].forEach(function(item){ var p=item.split(':'); %>
            <div class="toggle-card" data-field="<%= p[0] %>" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress[p[0]] %>">
              <div class="tc-head"><span class="tc-icon"><%= p[1] %></span><span class="tc-label"><%= p[2] %></span><span class="tc-check"></span></div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- EXAM TRACKER -->
      <section class="section" id="exam">
        <div class="section-title"><span class="icon">📜</span> Claude Dev Cert <span class="hint"><%= examStats.daysUntilCert %> days to Oct 1</span></div>
        <div class="grid cols-3">
          <div class="card"><div class="proj-label">Total Study</div><div class="proj-value"><%= Math.round(examStats.totalMinutes / 60 * 10) / 10 %>h</div></div>
          <div class="card"><div class="proj-label">Topics</div><div class="proj-value"><%= examStats.topics %></div></div>
          <div class="card"><div class="proj-label">Readiness</div><div class="proj-value"><%= examStats.topScore %>/10</div></div>
        </div>
        <div class="card mt">
          <div class="card-title">Quick Log Study Session</div>
          <div class="grid cols-2">
            <input class="input" type="text" id="exam-topic" placeholder="Topic" />
            <div class="grid cols-2" style="grid-template-columns:1fr 1fr;">
              <input class="input" type="number" id="exam-mins" placeholder="Minutes" min="0" />
              <input class="input" type="number" id="exam-score" placeholder="Ready 1-10" min="1" max="10" />
            </div>
          </div>
          <textarea class="input mt" id="exam-notes" placeholder="Notes (optional)" style="min-height:60px;"></textarea>
          <button class="btn btn-primary mt" onclick="addExamSession()">+ Log Session</button>
        </div>
        <% if (examData && examData.length) { %>
          <div class="card mt">
            <div class="card-title">Recent Sessions</div>
            <% examData.forEach(function(e){ %>
              <div class="problem-item">
                <div class="p-name"><%= e.topic %> — <%= e.minutes_studied %> min</div>
                <div class="p-meta"><span><%= new Date(e.date).toLocaleDateString() %></span><span>Ready: <%= e.ready_score %>/10</span></div>
                <% if (e.notes) { %><div class="p-notes"><%= e.notes %></div><% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>

    </div><!-- /tab-dashboard -->

    <!-- ============================== TAB: PROGRESS ============================== -->
    <div class="tab-content" id="tab-progress">

      <section class="section">
        <div class="section-title"><span class="icon">📊</span> DSA Unaided Tracking</div>
        <div class="card">
          <div class="grid cols-4">
            <div class="stat-box green"><div class="sb-num"><%= dsaUnaided.alone %></div><div class="sb-label">🟢 Alone</div></div>
            <div class="stat-box yellow"><div class="sb-num"><%= dsaUnaided.hint %></div><div class="sb-label">🟡 Hint</div></div>
            <div class="stat-box orange"><div class="sb-num"><%= dsaUnaided.copilot %></div><div class="sb-label">🟠 Copilot</div></div>
            <div class="stat-box"><div class="sb-num"><%= dsaUnaided.percent %>%</div><div class="sb-label">Unaided</div></div>
          </div>
          <div class="progress-wrap mt"><div class="progress-bar" style="width:<%= dsaUnaided.percent %>%"></div></div>
        </div>
      </section>

      <section class="section">
        <div class="section-title"><span class="icon">🔥</span> Streak Calendar (30 days)</div>
        <div class="card">
          <div class="streak-grid" id="streakGrid">
            <% (streakCalendar || []).forEach(function(d){ %>
              <div class="streak-cell <%= d.active_day ? 'active' : 'inactive' %>" title="<%= new Date(d.date).toLocaleDateString() %> <%= d.active_day ? '✅ Active' : '— rest' %>">
                <%= new Date(d.date).getDate() %>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-title"><span class="icon">💻</span> DSA Problems (<%= dsaCount %>)</div>
        <div class="card">
          <div class="filter-chips" id="dsaFilters">
            <button class="chip active" data-filter="all">All</button>
            <button class="chip" data-filter="easy">Easy</button>
            <button class="chip" data-filter="medium">Medium</button>
            <button class="chip" data-filter="hard">Hard</button>
            <button class="chip" data-filter="alone">🟢 Alone</button>
            <button class="chip" data-filter="hint">🟡 Hint</button>
            <button class="chip" data-filter="copilot">🟠 Copilot</button>
          </div>
          <div class="dsa-table-wrap mt">
            <table class="dsa-table" id="dsaTable">
              <thead><tr><th>#</th><th>Problem</th><th>Pattern</th><th>Diff</th><th>Date</th><th>Help</th><th>Time</th><th></th></tr></thead>
              <tbody>
                <% (allDsa || []).forEach(function(p, i){ %>
                  <tr class="dsa-row" data-diff="<%= p.difficulty || 'easy' %>" data-help="<%= p.help_level || 'alone' %>">
                    <td><%= i + 1 %></td>
                    <td><%= p.problem_name %></td>
                    <td><%= p.pattern || '—' %></td>
                    <td><span class="diff-<%= p.difficulty || 'easy' %>"><%= (p.difficulty || '').toUpperCase() %></span></td>
                    <td><%= new Date(p.date).toLocaleDateString() %></td>
                    <td><%= p.help_level === 'alone' ? '🟢' : p.help_level === 'hint' ? '🟡' : '🟠' %></td>
                    <td><%= p.time_minutes || '—' %></td>
                    <td><button class="btn-ghost btn-sm" onclick="editDsa(<%= p.id %>)">Edit</button> <button class="btn-ghost btn-sm" onclick="deleteDsa(<%= p.id %>)">Del</button></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-title"><span class="icon">📉</span> Historical Charts</div>
        <% if (history && history.dsa && history.dsa.length) { %>
          <div class="card chart-card mt">
            <div class="card-title">DSA per day (14 days)</div>
            <div class="chart-bars">
              <% var maxDsa = Math.max.apply(null, history.dsa.map(function(d){ return d.count || 0; })); if(maxDsa===0) maxDsa=1; %>
              <% history.dsa.forEach(function(d){ %>
                <div class="chart-col"><div class="chart-bar-fill" style="height:<%= ((d.count||0)/maxDsa)*100 %>%"></div><div class="chart-label"><%= new Date(d.date).getDate() %></div></div>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (history && history.prayers && history.prayers.length) { %>
          <div class="card chart-card mt">
            <div class="card-title">Prayer completion (7 days)</div>
            <div class="chart-bars">
              <% history.prayers.forEach(function(d){ var count=0; if(d.fajr)count++; if(d.dhuhr)count++; if(d.asr)count++; if(d.maghrib)count++; if(d.isha)count++; %>
                <div class="chart-col"><div class="chart-bar-fill prayer-bar" style="height:<%= (count/5)*100 %>%"></div><div class="chart-label"><%= new Date(d.date).getDate() %></div></div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </section>

    </div><!-- /tab-progress -->

    <!-- ============================== TAB: JOURNAL ============================== -->
    <div class="tab-content" id="tab-journal">
      <section class="section">
        <div class="section-title"><span class="icon">📝</span> Journal</div>
        <div class="card">
          <div class="grid cols-2">
            <div><label class="field-label">Type</label>
              <select class="select" id="j-type"><option value="brain_dump">Brain Dump</option><option value="wins">3 Wins</option><option value="targets">3 Targets</option></select>
            </div>
          </div>
          <textarea class="input mt" id="j-content" placeholder="Write here..." style="min-height:100px;"></textarea>
          <button class="btn btn-gold mt" onclick="addJournal()">💾 Save Journal</button>
        </div>
        <div class="card mt">
          <div class="card-title">All Entries</div>
          <% (allJournal || []).forEach(function(e){ %>
            <div class="problem-item">
              <div class="p-name"><%= e.entry_type.replace(/_/g,' ') %></div>
              <div class="p-meta"><span><%= new Date(e.date).toLocaleDateString() %></span></div>
              <div class="p-notes"><%= e.content %></div>
            </div>
          <% }); %>
        </div>
      </section>
    </div><!-- /tab-journal -->

    <!-- ============================== TAB: SETTINGS ============================== -->
    <div class="tab-content" id="tab-settings">
      <section class="section">
        <div class="section-title"><span class="icon">⚙️</span> Settings</div>
        <div class="card">
          <div class="field"><label class="field-label">Motivational Quotes</label>
            <select class="select" id="set-quotes"><option value="true" <%= settings.quotes_toggle !== false ? 'selected' : '' %>>On</option><option value="false" <%= settings.quotes_toggle === false ? 'selected' : '' %>>Off</option></select>
          </div>
          <div class="field"><label class="field-label">Chart Range</label>
            <select class="select" id="set-chart"><option value="7" <%= settings.chart_range == 7 ? 'selected' : '' %>>7 days</option><option value="14" <%= settings.chart_range == 14 ? 'selected' : '' %>>14 days</option><option value="30" <%= settings.chart_range == 30 ? 'selected' : '' %>>30 days</option></select>
          </div>
          <div class="field"><label class="field-label">Dua Mode</label>
            <select class="select" id="set-dua"><option value="none" <%= settings.dua_mode == 'none' ? 'selected' : '' %>>None</option><option value="morning" <%= settings.dua_mode == 'morning' ? 'selected' : '' %>>Morning</option><option value="night" <%= settings.dua_mode == 'night' ? 'selected' : '' %>>Night</option></select>
          </div>
          <div class="field"><label class="field-label">Learning Block Names</label>
            <div class="grid cols-2">
              <% for (var b = 0; b < 4; b++) { %>
                <input class="input" type="text" id="set-block-<%= b %>" value="<%= (settings.learning_blocks && settings.learning_blocks[b]) || ['DSA','Spring Boot','System Design','Revision'][b] %>" />
              <% } %>
            </div>
          </div>
          <button class="btn btn-primary mt" onclick="saveSettings()">💾 Save Settings</button>
        </div>
      </section>
    </div><!-- /tab-settings -->

  </main>

  <!-- FOOTER QUOTE -->
  <% if (settings.quotes_toggle !== false) { %>
  <footer class="app-footer">
    <div class="container">
      <div class="quote-block">
        <div class="quote-text" id="quote-text">Loading…</div>
        <div class="quote-author" id="quote-author"></div>
      </div>
    </div>
  </footer>
  <% } %>

  <!-- DSA EDIT MODAL -->
  <div class="modal-overlay" id="dsaModal" style="display:none;">
    <div class="modal">
      <div class="modal-title">Edit DSA Problem</div>
      <input type="hidden" id="edit-id" />
      <input class="input" type="text" id="edit-name" placeholder="Problem Name" />
      <input class="input mt" type="text" id="edit-pattern" placeholder="Pattern" />
      <div class="grid cols-2 mt">
        <select class="select" id="edit-diff"><option value="easy">Easy</option><option value="medium">Medium</option><option value="hard">Hard</option></select>
        <select class="select" id="edit-help"><option value="alone">🟢 Alone</option><option value="hint">🟡 Hint</option><option value="copilot">🟠 Copilot</option></select>
      </div>
      <div class="grid cols-2 mt">
        <input class="input" type="number" id="edit-time" placeholder="Time (min)" />
        <input class="input" type="date" id="edit-date" />
      </div>
      <textarea class="input mt" id="edit-notes" placeholder="Notes" style="min-height:60px;"></textarea>
      <div class="row mt" style="gap:8px;">
        <button class="btn btn-primary" onclick="saveDsaEdit()">Save</button>
        <button class="btn btn-ghost" onclick="closeDsaModal()">Cancel</button>
      </div>
    </div>
  </div>

  <!-- TOAST -->
  <div class="toast" id="toast">Saved ✓</div>

  <script>
  (function () {
    "use strict";
    var todayProgress = <%- JSON.stringify(todayProgress || {}) %>;
    var allDsaData = <%- JSON.stringify(allDsa || []) %>;

    var toastEl = document.getElementById('toast'), toastTimer;
    function toast(msg, isError) { toastEl.textContent = msg; toastEl.classList.toggle('error', !!isError); toastEl.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 2200); }

    /* Tab navigation */
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
        document.querySelectorAll('.tab-content').forEach(function(c){ c.classList.remove('active'); });
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      });
    });

    /* Toggle cards */
    document.querySelectorAll('.toggle-card').forEach(function(card) {
      var field = card.getAttribute('data-field');
      if (todayProgress[field]) { card.classList.add('checked'); card.setAttribute('aria-checked','true'); }
      function toggle() { setProgress(field, !card.classList.contains('checked'), card); }
      card.addEventListener('click', function(e){ e.preventDefault(); toggle(); });
      card.addEventListener('keydown', function(e){ if(e.key===' '||e.key==='Enter'){ e.preventDefault(); toggle(); } });
    });

    function setProgress(field, value, card) {
      var prev = card.classList.contains('checked');
      card.classList.toggle('checked', value); card.setAttribute('aria-checked', String(value));
      updateDerived();
      var body = new URLSearchParams(); body.append('field', field); body.append('value', value ? '1' : '0');
      fetch('/api/progress', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body.toString() })
        .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
        .then(function(){ todayProgress[field]=value; toast(value?'✓ Logged':'✗ Unchecked'); })
        .catch(function(){ card.classList.toggle('checked',prev); card.setAttribute('aria-checked',String(prev)); updateDerived(); toast('Failed to save', true); });
    }

    var blockFields = ['block1_done','block2_done','block3_done','block4_done'];
    var salahFields = ['fajr','dhuhr','asr','maghrib','isha'];
    function updateDerived() {
      var done = blockFields.filter(function(f){ var c=document.querySelector('.toggle-card[data-field="'+f+'"]'); return c && c.classList.contains('checked'); }).length;
      var bd = document.getElementById('blocks-done'); if (bd) bd.textContent = done;
      var salahCards = document.querySelectorAll('#salah .toggle-card');
      var allSalah = true;
      salahCards.forEach(function(c){ var f=c.getAttribute('data-field'); if(salahFields.indexOf(f)!==-1 && !c.classList.contains('checked')) allSalah=false; });
      var cel = document.getElementById('salah-celebrate'); if(cel) cel.classList.toggle('show', allSalah && salahCards.length>=5);
    }
    updateDerived();

    /* DSA filter chips */
    document.querySelectorAll('#dsaFilters .chip').forEach(function(chip) {
      chip.addEventListener('click', function() {
        document.querySelectorAll('#dsaFilters .chip').forEach(function(c){ c.classList.remove('active'); });
        chip.classList.add('active');
        var filter = chip.dataset.filter;
        document.querySelectorAll('#dsaTable .dsa-row').forEach(function(row) {
          if (filter === 'all') { row.style.display = ''; }
          else if (filter === 'easy' || filter === 'medium' || filter === 'hard') { row.style.display = row.dataset.diff === filter ? '' : 'none'; }
          else { row.style.display = row.dataset.help === filter ? '' : 'none'; }
        });
      });
    });

    /* DSA edit modal */
    window.editDsa = function(id) {
      var p = allDsaData.find(function(d){ return d.id == id; });
      if (!p) return;
      document.getElementById('edit-id').value = p.id;
      document.getElementById('edit-name').value = p.problem_name || '';
      document.getElementById('edit-pattern').value = p.pattern || '';
      document.getElementById('edit-diff').value = p.difficulty || 'easy';
      document.getElementById('edit-help').value = p.help_level || 'alone';
      document.getElementById('edit-time').value = p.time_minutes || '';
      document.getElementById('edit-date').value = p.date ? new Date(p.date).toISOString().split('T')[0] : '';
      document.getElementById('edit-notes').value = p.notes || '';
      document.getElementById('dsaModal').style.display = 'flex';
    };
    window.closeDsaModal = function() { document.getElementById('dsaModal').style.display = 'none'; };
    window.saveDsaEdit = function() {
      var body = new URLSearchParams();
      body.append('problem_name', document.getElementById('edit-name').value);
      body.append('pattern', document.getElementById('edit-pattern').value);
      body.append('difficulty', document.getElementById('edit-diff').value);
      body.append('help_level', document.getElementById('edit-help').value);
      body.append('time_minutes', document.getElementById('edit-time').value);
      body.append('date', document.getElementById('edit-date').value);
      body.append('notes', document.getElementById('edit-notes').value);
      body.append('needed_help', document.getElementById('edit-help').value !== 'alone');
      var id = document.getElementById('edit-id').value;
      fetch('/api/dsa/' + id, { method:'PUT', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body.toString() })
        .then(function(r){ return r.json(); })
        .then(function(){ toast('✓ Updated'); setTimeout(function(){ location.reload(); }, 800); })
        .catch(function(){ toast('Failed', true); });
    };
    window.deleteDsa = function(id) {
      if (!confirm('Delete this problem?')) return;
      fetch('/api/dsa/' + id, { method:'DELETE' })
        .then(function(r){ return r.json(); })
        .then(function(){ toast('✓ Deleted'); setTimeout(function(){ location.reload(); }, 600); })
        .catch(function(){ toast('Failed', true); });
    };

    /* Exam session */
    window.addExamSession = function() {
      var body = new URLSearchParams();
      body.append('topic', document.getElementById('exam-topic').value);
      body.append('minutes_studied', document.getElementById('exam-mins').value);
      body.append('ready_score', document.getElementById('exam-score').value);
      body.append('notes', document.getElementById('exam-notes').value);
      fetch('/api/exam', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body.toString() })
        .then(function(r){ return r.json(); })
        .then(function(){ toast('✓ Session logged'); setTimeout(function(){ location.reload(); }, 800); })
        .catch(function(){ toast('Failed', true); });
    };

    /* Journal */
    window.addJournal = function() {
      var body = new URLSearchParams();
      body.append('entry_type', document.getElementById('j-type').value);
      body.append('content', document.getElementById('j-content').value);
      fetch('/api/journal', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body.toString() })
        .then(function(r){ return r.json(); })
        .then(function(){ toast('✓ Journal saved'); document.getElementById('j-content').value=''; })
        .catch(function(){ toast('Failed', true); });
    };

    /* Settings */
    window.saveSettings = function() {
      var blocks = [];
      for (var i = 0; i < 4; i++) blocks.push(document.getElementById('set-block-'+i).value);
      var body = new URLSearchParams();
      body.append('quotes_toggle', document.getElementById('set-quotes').value === 'true');
      body.append('chart_range', document.getElementById('set-chart').value);
      body.append('dua_mode', document.getElementById('set-dua').value);
      body.append('learning_blocks', JSON.stringify(blocks));
      fetch('/api/settings', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body.toString() })
        .then(function(r){ return r.json(); })
        .then(function(){ toast('✓ Settings saved'); })
        .catch(function(){ toast('Failed', true); });
    };

    /* Rotating quotes */
    var quotes = [
      { t: "Verily, with hardship comes ease.", a: "Qur'an 94:6" },
      { t: "The strong believer is better and more beloved to Allah than the weak believer, though in both is good.", a: "Prophet Muhammad ﷺ" },
      { t: "Take advantage of five before five: your youth before old age, your health before sickness, your wealth before poverty, your free time before busyness, your life before death.", a: "Prophet Muhammad ﷺ" },
      { t: "Allah does not burden a soul beyond that it can bear.", a: "Qur'an 2:286" },
      { t: "Indeed, Allah will not change the condition of a people until they change what is in themselves.", a: "Qur'an 13:11" },
      { t: "The secret of getting ahead is getting started.", a: "Mark Twain" },
      { t: "You are what you repeatedly do. Excellence is a habit, not an act.", a: "Aristotle" },
      { t: "And whoever puts their trust in Allah — He is sufficient for them.", a: "Qur'an 65:3" },
      { t: "Do not despise any good deed, even meeting your brother with a cheerful face.", a: "Prophet Muhammad ﷺ" },
      { t: "Fall seven times, stand up eight.", a: "Japanese Proverb" },
      { t: "Discipline is the bridge between goals and accomplishment.", a: "Jim Rohn" },
      { t: "The one who is not grateful to people is not grateful to Allah.", a: "Prophet Muhammad ﷺ" },
      { t: "Your life is a ship; discipline is the sail, and intention is the compass.", a: "Unknown" },
      { t: "When you arise in the morning, think of what a precious privilege it is to be alive.", a: "Marcus Aurelius" },
      { t: "The best of people are those most beneficial to people.", a: "Prophet Muhammad ﷺ" }
    ];
    var q = quotes[new Date().getDate() % quotes.length];
    var qt = document.getElementById('quote-text');
    var qa = document.getElementById('quote-author');
    if (qt) qt.textContent = '"' + q.t + '"';
    if (qa) qa.textContent = '— ' + q.a;

  })();
  </script>
</body>
</html>
