      </div>
    </section>

    <!-- ============================== 14. WEEKLY REVIEW ============================== -->
    <section class="section" id="review">
      <div class="section-title">
        <span class="icon">📊</span> Weekly Review
        <span class="hint"><% if (review) { %>Week <%= review.week_number %><% } else { %>Not yet submitted this week<% } %></span>
      </div>
      <div class="card">
        <form id="review-form">
          <div class="grid cols-2">
            <div class="field">
              <label for="r-salah">Salah Hits (of 35)</label>
              <input class="input" type="number" id="r-salah" name="salah_hits" min="0" max="35"
                     value="<%= review ? review.salah_hits : '' %>" placeholder="e.g. 28" />
            </div>
            <div class="field">
              <label for="r-dsa">DSA Count</label>
              <input class="input" type="number" id="r-dsa" name="dsa_count" min="0"
                     value="<%= review ? review.dsa_count : '' %>" placeholder="e.g. 18" />
            </div>
          </div>
          <div class="field">
            <label for="r-notes">Week Notes</label>
            <textarea class="textarea" id="r-notes" name="notes" placeholder="What went well? What to improve next week?"><%= review ? review.notes : '' %></textarea>
          </div>
          <div class="field">
            <label for="r-shield">Shield Notes</label>
            <textarea class="textarea" id="r-shield" name="shield_notes" placeholder="How did the shields hold up this week?"><%= review ? review.shield_notes : '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            <span class="btn-label">📋 Save Weekly Review</span>
          </button>
        </form>
      </div>
    </section>

    <!-- ============================== 15. HISTORICAL CHARTS ============================== -->
    <section class="section" id="charts">
      <div class="section-title">
        <span class="icon">📉</span> Historical Charts
        <span class="hint">Trends over time</span>
      </div>

      <% if (history && history.dsa && history.dsa.length) { %>
      <%
        var maxDsa = Math.max.apply(null, history.dsa.map(function(d){ return d.count || 0; }));
        if (maxDsa === 0) maxDsa = 1;
      %>
      <div class="card chart-card">
        <div class="card-title">DSA Problems Per Day (Last 14 Days)</div>
        <div class="chart-bars" id="chart-dsa">
          <% history.dsa.forEach(function(d){ %>
            <div class="chart-col" data-count="<%= d.count %>">
              <div class="chart-bar-wrap">
                <div class="chart-bar chart-bar--emerald" style="height:<%= d.count > 0 ? Math.max(4, (d.count / maxDsa * 100)) : 0 %>%" title="<%= d.count %> problems">
                  <span class="chart-val"><%= d.count %></span>
                </div>
              </div>
              <span class="chart-date"><%= new Date(d.date).toLocaleDateString('en-US', { month:'numeric', day:'numeric' }) %></span>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (history && history.bars && history.bars.length) { %>
      <div class="card chart-card mt">
        <div class="card-title">Bar Hits (Last 7 Days)</div>
        <div class="chart-bars" id="chart-bars">
          <% history.bars.forEach(function(d){ %>
            <div class="chart-col" data-bar="<%= d.bar_hit || '' %>">
              <div class="chart-bar-wrap">
                <div class="chart-bar <%= d.bar_hit === 'high' ? 'chart-bar--gold' : d.bar_hit === 'low' ? 'chart-bar--emerald' : 'chart-bar--empty' %>" style="height:<%= d.bar_hit ? 100 : 4 %>%">
                  <span class="chart-val"><%= d.bar_hit === 'high' ? '🟡' : d.bar_hit === 'low' ? '🟢' : '—' %></span>
                </div>
              </div>
              <span class="chart-date"><%= new Date(d.date).toLocaleDateString('en-US', { weekday:'short' }) %></span>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (history && history.prayers && history.prayers.length) { %>
      <div class="card chart-card mt">
        <div class="card-title">Prayer Completion (Last 7 Days)</div>
        <div class="chart-bars" id="chart-prayers">
          <% history.prayers.forEach(function(d){ %>
            <%
              var total = (d.fajr?1:0) + (d.dhuhr?1:0) + (d.asr?1:0) + (d.maghrib?1:0) + (d.isha?1:0);
              var pct = (total / 5) * 100;
            %>
            <div class="chart-col" data-prayers="<%= total %>">
              <div class="chart-bar-wrap">
                <div class="chart-bar chart-bar--emerald" style="height:<%= total > 0 ? Math.max(8, pct) : 4 %>%">
                  <span class="chart-val"><%= total %>/5</span>
                </div>
              </div>
              <span class="chart-date"><%= new Date(d.date).toLocaleDateString('en-US', { weekday:'short' }) %></span>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </section>

  </main>

  <!-- ============================== 16. FOOTER QUOTE ============================== -->
  <footer class="app-footer">
    <div class="container">
      <div class="quote-block">
        <div class="quote-text" id="quote-text">Loading today's motivation…</div>
        <div class="quote-author" id="quote-author"></div>
      </div>
    </div>
  </footer>

  <!-- Toast -->
  <div class="toast" id="toast">Saved ✓</div>

  <!-- Pass server data to client -->
  <script id="server-data" type="application/json">
  <%- JSON.stringify({
    todayProgress: todayProgress || {},
    history: history || { dsa: [], bars: [], prayers: [] },
    recentDsa: recentDsa || []
  }) %>
  </script>

  <script>
  /* =====================================================================
     Client-side logic: toggles, AJAX, DSA list, journal, review, quotes, charts
     ===================================================================== */
  (function () {
    "use strict";

    /* Parse server-injected data */
    var serverData = JSON.parse(document.getElementById('server-data').textContent);
    var todayProgress = serverData.todayProgress;
    var history = serverData.history;
    var recentDsa = serverData.recentDsa;

    /* ---- Toast ---- */
    var toastEl = document.getElementById('toast');
    var toastTimer;
    function toast(msg, isError) {
      toastEl.textContent = msg;
      toastEl.classList.toggle('error', !!isError);
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 2200);
    }

    /* ---- Initialize toggle cards ---- */
    var cards = document.querySelectorAll('.toggle-card');
    cards.forEach(function (card) {
      var field = card.getAttribute('data-field');
      if (todayProgress[field]) {
        card.classList.add('checked');
        card.setAttribute('aria-checked', 'true');
      } else {
        card.setAttribute('aria-checked', 'false');
      }

      function toggle() {
        var newVal = !card.classList.contains('checked');
        setProgress(field, newVal, card);
      }

      card.addEventListener('click', function (e) {
        e.preventDefault();
        toggle();
      });
      card.addEventListener('keydown', function (e) {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          toggle();
        }
      });
    });

    /* ---- AJAX: POST /api/progress ---- */
    /* Allowed fields including the new ones */
    var allowedFields = [
      'survival_layer','tahajjud','fajr','duha','fasting','jumuah',
      'dhuhr','asr','maghrib','isha',
      'morning_reading','targets_set','house_task',
      'mma','post_workout_meal','shower',
      'block1_done','block2_done','block3_done','block4_done',
      'ghusl_rule','khalwah_shield','night_protocol','phone_out_of_bedroom','lower_gaze','no_new_riba',
      'haldi_doodh','sleep_on_wudu','evening_reset',
      'bar_hit','mode_used','office_time_used','claude_cert_minutes','active_day'
    ];

    function setProgress(field, value, card) {
      var prev = card.classList.contains('checked');
      // optimistic
      card.classList.toggle('checked', value);
      card.setAttribute('aria-checked', String(value));
      updateDerived();

      var body = new URLSearchParams();
      body.append('field', field);
      body.append('value', value ? '1' : '0');

      fetch('/api/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
      })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function () {
        todayProgress[field] = value;
        toast(value ? '✓ Logged' : '✗ Unchecked');
      })
      .catch(function () {
        // rollback
        card.classList.toggle('checked', prev);
        card.setAttribute('aria-checked', String(prev));
        updateDerived();
        toast('Failed to save — check connection', true);
      });
    }

    /* ---- Derived UI: blocks counter + salah celebration ---- */
    var blockFields = ['block1_done','block2_done','block3_done','block4_done'];
    var salahFields = ['fajr','dhuhr','asr','maghrib','isha'];

    function updateDerived() {
      // blocks
      var done = blockFields.filter(function (f) {
        var c = document.querySelector('.toggle-card[data-field="' + f + '"]');
        return c && c.classList.contains('checked');
      }).length;
      var bd = document.getElementById('blocks-done');
      if (bd) bd.textContent = done;

      // salah celebration — must check the salah-section cards specifically
      var salahCards = document.querySelectorAll('#salah .toggle-card');
      var allSalah = true;
      salahCards.forEach(function (c) {
        var f = c.getAttribute('data-field');
        if (salahFields.indexOf(f) !== -1 && !c.classList.contains('checked')) allSalah = false;
      });
      var cel = document.getElementById('salah-celebrate');
      if (cel) cel.classList.toggle('show', allSalah && salahCards.length >= 5);
    }
    updateDerived();

    /* ---- DSA form ---- */
    var dsaForm = document.getElementById('dsa-form');
    dsaForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = dsaForm.querySelector('button');
      var label = btn.querySelector('.btn-label');
      var orig = label.textContent;
      label.innerHTML = '<span class="spin">⏳</span> Saving…';
      btn.disabled = true;

      var body = new URLSearchParams(new FormData(dsaForm));
      fetch('/api/dsa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
      })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (data) {
        addProblemToList(data.problem || data);
        dsaForm.reset();
        toast('💪 Problem logged!');
      })
      .catch(function () { toast('Failed to log problem', true); })
      .finally(function () {
        label.textContent = orig;
        btn.disabled = false;
      });
    });

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
      });
    }

    function addProblemToList(p) {
      var list = document.getElementById('dsa-list');
      var empty = list.querySelector('.empty-state');
      if (empty) empty.remove();
      var div = document.createElement('div');
      div.className = 'problem-item';
      var diff = p.difficulty || 'easy';
      var diffClass = 'diff-' + diff;
      var hl = p.help_level || '';
      var hlBadge = hl ? '<span class="hl-badge hl-badge--' + escapeHtml(hl) + '">' + escapeHtml(hl) + '</span>' : '';
      var neededHelp = p.needed_help ? '<span>💡 needed help</span>' : '';
      div.innerHTML =
        '<div class="p-name">' + escapeHtml(p.name) + '</div>' +
        '<div class="p-meta">' +
          (p.pattern ? '<span>📐 ' + escapeHtml(p.pattern) + '</span>' : '') +
          '<span class="' + diffClass + '">' + escapeHtml(diff.toUpperCase()) + '</span>' +
          (p.time ? '<span>⏱ ' + escapeHtml(p.time) + ' min</span>' : '') +
          hlBadge + neededHelp +
        '</div>' +
        (p.notes ? '<div class="p-notes">' + escapeHtml(p.notes) + '</div>' : '');
      list.prepend(div);
    }

    /* ---- Journal form ---- */
    var jForm = document.getElementById('journal-form');
    jForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = jForm.querySelector('button');
      var label = btn.querySelector('.btn-label');
      var orig = label.textContent;
      label.innerHTML = '<span class="spin">⏳</span> Saving…';
      btn.disabled = true;

      var body = new URLSearchParams(new FormData(jForm));
      fetch('/api/journal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
      })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function () {
        toast('📝 Journal saved!');
      })
      .catch(function () { toast('Failed to save journal', true); })
      .finally(function () {
        label.textContent = orig;
        btn.disabled = false;
      });
    });

    /* ---- Weekly review form ---- */
    var rForm = document.getElementById('review-form');
    rForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = rForm.querySelector('button');
      var label = btn.querySelector('.btn-label');
      var orig = label.textContent;
      label.innerHTML = '<span class="spin">⏳</span> Saving…';
      btn.disabled = true;

      var body = new URLSearchParams(new FormData(rForm));
      fetch('/api/review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
      })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function () { toast('📋 Review saved!'); })
      .catch(function () { toast('Failed to save review', true); })
      .finally(function () {
        label.textContent = orig;
        btn.disabled = false;
      });
    });

    /* ---- Rotating footer quote (daily) ---- */
    var quotes = [
      { t: "Verily, with hardship comes ease.", a: "Qur'an 94:6" },
      { t: "The best of people are those most beneficial to people.", a: "Prophet Muhammad ﷺ" },
      { t: "The strong believer is better and more beloved to Allah than the weak believer, though in both is good.", a: "Prophet Muhammad ﷺ" },
