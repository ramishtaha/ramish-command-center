<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Command Center</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="/logout" class="logout-btn">Logout</a>
  <div class="dashboard">

    <!-- HEADER -->
    <div class="header">
      <h1>بِسْمِ اللَّهِ</h1>
      <div class="date"><%= today.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></div>
      <div class="progress-wrap">
        <div class="progress-label">
          <span>12-Week Journey</span>
          <span>Day <%= dayNumber %> of 84</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= Math.min(100, (dayNumber / 84) * 100) %>%"></div>
        </div>
      </div>
      <div class="streaks">
        <div class="streak-badge"><span class="fire">🔥</span> Salah: <span class="count"><%= salahStreak %></span></div>
        <div class="streak-badge"><span class="fire">🔥</span> DSA: <span class="count"><%= dsaStreak %></span></div>
        <div class="streak-badge"><span class="fire">🔥</span> Survival: <span class="count"><%= survivalStreak %></span></div>
      </div>
    </div>

    <!-- WEEK STATS -->
    <% if (weekStats && weekStats.total_days > 0) { %>
    <div class="section">
      <div class="section-title"><span class="icon">📊</span> This Week</div>
      <div class="week-stats">
        <div class="week-stat"><div class="num" style="color: var(--emerald)"><%= weekStats.salah_complete_days || 0 %>/7</div><div class="label">Salah Complete</div></div>
        <div class="week-stat"><div class="num" style="color: var(--gold)"><%= weekStats.dsa_days || 0 %>/7</div><div class="label">DSA Days</div></div>
        <div class="week-stat"><div class="num" style="color: var(--blue)"><%= weekStats.mma_days || 0 %>/7</div><div class="label">MMA Days</div></div>
        <div class="week-stat"><div class="num" style="color: var(--purple)"><%= weekStats.survival_days || 0 %>/7</div><div class="label">Survival Days</div></div>
      </div>
    </div>
    <% } %>

    <!-- SURVIVAL LAYER -->
    <div class="section">
      <div class="section-title"><span class="icon">⚡</span> Survival Layer <span class="badge">NO PHONE</span></div>
      <div class="cards-grid">
        <div class="toggle-card <%= todayProgress.survival_layer ? 'checked' : '' %>" data-field="survival_layer">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Alarm off + feet on floor</div><div class="card-time">04:20 AM</div></div>
        </div>
        <div class="toggle-card" data-field="survival_layer_teeth">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Brush teeth + cold water</div><div class="card-time">04:25 AM</div></div>
        </div>
        <div class="toggle-card" data-field="survival_layer_wudu">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Wudu</div><div class="card-time">04:30 AM</div></div>
        </div>
        <div class="toggle-card" data-field="tahajjud">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Tahajjud</div><div class="card-time">04:30 AM</div></div>
        </div>
      </div>
    </div>

    <!-- SALAH TRACKER -->
    <div class="section">
      <div class="section-title"><span class="icon">🕌</span> Salah Tracker <span class="badge">All 5 Daily</span></div>
      <div class="salah-grid">
        <div class="salah-card <%= todayProgress.fajr ? 'checked' : '' %>" data-field="fajr">
          <div class="prayer-icon">🌅</div>
          <div class="prayer-name">Fajr</div>
        </div>
        <div class="salah-card <%= todayProgress.dhuhr ? 'checked' : '' %>" data-field="dhuhr">
          <div class="prayer-icon">☀️</div>
          <div class="prayer-name">Dhuhr</div>
        </div>
        <div class="salah-card <%= todayProgress.asr ? 'checked' : '' %>" data-field="asr">
          <div class="prayer-icon">🌤️</div>
          <div class="prayer-name">Asr</div>
        </div>
        <div class="salah-card <%= todayProgress.magrib ? 'checked' : '' %>" data-field="magrib">
          <div class="prayer-icon">🌆</div>
          <div class="prayer-name">Maghrib</div>
        </div>
        <div class="salah-card <%= todayProgress.isha ? 'checked' : '' %>" data-field="isha">
          <div class="prayer-icon">🌙</div>
          <div class="prayer-name">Isha</div>
        </div>
      </div>
      <% const isFriday = today.getDay() === 5; %>
      <% if (isFriday) { %>
      <div style="margin-top: 10px;">
        <div class="salah-card <%= todayProgress.jumuah ? 'checked' : '' %>" data-field="jumuah" style="max-width: 200px; margin: 0 auto;">
          <div class="prayer-icon">🕌</div>
          <div class="prayer-name">Jumu'ah — Mosque</div>
        </div>
      </div>
      <% } %>
      <div class="salah-complete-banner" id="salahBanner">🎉 All 5 prayers complete! Mashallah! 🎉</div>
    </div>

    <!-- PRIME LAYER -->
    <div class="section">
      <div class="section-title"><span class="icon">🧠</span> Prime Layer</div>
      <div class="cards-grid">
        <div class="toggle-card <%= todayProgress.morning_reading ? 'checked' : '' %>" data-field="morning_reading">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Morning reading (20 min)</div><div class="card-time">05:00 AM</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.targets_set ? 'checked' : '' %>" data-field="targets_set">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">3 non-negotiable targets</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.house_task ? 'checked' : '' %>" data-field="house_task">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">1 house task</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.duha ? 'checked' : '' %>" data-field="duha">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Duha (bonus)</div><div class="card-time">09:00 AM</div></div>
        </div>
      </div>
    </div>

    <!-- TRAINING -->
    <div class="section">
      <div class="section-title"><span class="icon">💪</span> Training</div>
      <div class="cards-grid">
        <div class="toggle-card <%= todayProgress.mma ? 'checked' : '' %>" data-field="mma">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">MMA Training</div><div class="card-time">07:00–08:00 AM</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.post_workout_meal ? 'checked' : '' %>" data-field="post_workout_meal">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Post-workout meal</div><div class="card-time">IMMEDIATELY</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.shower ? 'checked' : '' %>" data-field="shower">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Shower + dressed</div></div>
        </div>
      </div>
    </div>

    <!-- LEARNING BLOCKS -->
    <div class="section">
      <div class="section-title"><span class="icon">📖</span> Learning Blocks <span class="badge">6 hrs/day</span></div>
      <div class="learning-block <%= todayProgress.block1_done ? 'done' : '' %>" data-field="block1_done">
        <div class="block-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="block-info"><div class="block-title">Block 1 — DSA (NeetCode 150)</div><div class="block-meta">05:15 AM · 1h 15m</div></div>
      </div>
      <div class="learning-block <%= todayProgress.block2_done ? 'done' : '' %>" data-field="block2_done">
        <div class="block-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="block-info"><div class="block-title">Block 2 — Spring Boot / Project</div><div class="block-meta">08:50 AM · 1h 40m</div></div>
      </div>
      <div class="learning-block <%= todayProgress.block3_done ? 'done' : '' %>" data-field="block3_done">
        <div class="block-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="block-info"><div class="block-title">Block 3 — System Design / DevOps / AI</div><div class="block-meta">07:55 PM · 1h</div></div>
      </div>
      <div class="learning-block <%= todayProgress.block4_done ? 'done' : '' %>" data-field="block4_done">
        <div class="block-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="block-info"><div class="block-title">Block 4 — Revision + Daily LeetCode</div><div class="block-meta">09:05 PM · 30m</div></div>
      </div>
      <div class="learning-total" id="learningTotal"></div>
    </div>

    <!-- SHIELDS -->
    <div class="section">
      <div class="section-title"><span class="icon">🛡️</span> Daily Shields</div>
      <div class="cards-grid">
        <div class="toggle-card <%= todayProgress.ghusl_rule ? 'checked' : '' %>" data-field="ghusl_rule">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Ghusl Rule — immediate, no delay</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.khalwah_shield ? 'checked' : '' %>" data-field="khalwah_shield">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Khalwah Shield — public only</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.night_protocol ? 'checked' : '' %>" data-field="night_protocol">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Night Protocol — sleep on wudu</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.phone_out_of_bedroom ? 'checked' : '' %>" data-field="phone_out_of_bedroom">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Phone out of bedroom</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.lower_gaze ? 'checked' : '' %>" data-field="lower_gaze">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Lower the gaze</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.no_new_riba ? 'checked' : '' %>" data-field="no_new_riba">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">No new riba (cards/loans)</div></div>
        </div>
      </div>
    </div>

    <!-- EVENING RESET -->
    <div class="section">
      <div class="section-title"><span class="icon">🌙</span> Evening Reset</div>
      <div class="cards-grid">
        <div class="toggle-card <%= todayProgress.evening_reset ? 'checked' : '' %>" data-field="evening_reset">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Evening Reset checklist done</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.haldi_doodh ? 'checked' : '' %>" data-field="haldi_doodh">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Haldi doodh + black pepper</div><div class="card-time">10:00 PM</div></div>
        </div>
        <div class="toggle-card <%= todayProgress.sleep_on_wudu ? 'checked' : '' %>" data-field="sleep_on_wudu">
          <div class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="card-label">Sleep on wudu</div><div class="card-time">10:15 PM</div></div>
        </div>
      </div>
    </div>

    <!-- DSA TRACKER -->
    <div class="section">
      <div class="section-title"><span class="icon">🧩</span> DSA Tracker <span class="badge"><%= dsaCount %> solved</span></div>
      <form id="dsaForm" style="margin-bottom: 16px;">
        <div class="form-row">
          <div class="form-group">
            <label>Problem Name</label>
            <input type="text" name="problem_name" placeholder="e.g. Two Sum" required>
          </div>
          <div class="form-group">
            <label>Pattern</label>
            <input type="text" name="pattern" placeholder="e.g. Hash Map">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Difficulty</label>
            <select name="difficulty">
              <option value="Easy">Easy</option>
              <option value="Medium">Medium</option>
              <option value="Hard">Hard</option>
            </select>
          </div>
          <div class="form-group">
            <label>Time (minutes)</label>
            <input type="number" name="time_minutes" placeholder="20">
          </div>
        </div>
        <div class="form-group">
          <label>Notes</label>
          <textarea name="notes" placeholder="Approach, edge cases, lessons..."></textarea>
        </div>
        <button type="submit" class="btn">+ Add Problem</button>
      </form>
      <% if (typeof recentDsa !== 'undefined' && recentDsa.length > 0) { %>
      <div class="dsa-list">
        <% recentDsa.forEach(function(p) { %>
        <div class="dsa-item">
          <div>
            <div class="name"><%= p.problem_name %></div>
            <div class="meta"><%= p.date %><% if (p.pattern) { %> · <%= p.pattern %><% } %><% if (p.time_minutes) { %> · <%= p.time_minutes %>m<% } %></div>
          </div>
          <% if (p.difficulty) { %>
          <div class="diff-badge diff-<%= p.difficulty.toLowerCase() %>"><%= p.difficulty %></div>
          <% } %>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

    <!-- JOURNAL -->
    <div class="section">
      <div class="section-title"><span class="icon">📝</span> Journal</div>
      <div class="journal-section">
        <label>3 Wins from Today</label>
        <textarea id="journal_wins" placeholder="What went well today?"></textarea>
      </div>
      <div class="journal-section">
        <label>3 Targets for Tomorrow</label>
        <textarea id="journal_targets" placeholder="What are your 3 non-negotiables?"></textarea>
      </div>
      <div class="journal-section">
        <label>Brain Dump</label>
        <textarea id="journal_braindump" placeholder="5 min freewrite — whatever is on your mind"></textarea>
      </div>
      <button class="btn btn-gold" onclick="saveJournal()">Save Journal</button>
    </div>

    <!-- WEEKLY REVIEW -->
    <div class="section">
      <div class="section-title"><span class="icon">📋</span> Weekly Review</div>
      <div class="review-stats">
        <div class="review-stat"><div class="num"><%= weekStats.salah_complete_days || 0 %>/7</div><div class="label">Salah</div></div>
        <div class="review-stat"><div class="num"><%= dsaCount %></div><div class="label">DSA Total</div></div>
        <div class="review-stat"><div class="num"><%= dayNumber %></div><div class="label">Day of 84</div></div>
      </div>
      <form id="reviewForm">
        <div class="form-row">
          <div class="form-group">
            <label>Week Number</label>
            <input type="number" name="week_number" placeholder="1" min="1" max="12" value="<%= Math.ceil(dayNumber / 7) || 1 %>">
          </div>
          <div class="form-group">
            <label>Salah hits (out of 5)</label>
            <input type="number" name="salah_hits" placeholder="5" min="0" max="5">
          </div>
        </div>
        <div class="form-group">
          <label>DSA problems this week</label>
          <input type="number" name="dsa_count" placeholder="15" min="0">
        </div>
        <div class="form-group">
          <label>Shield Notes (what worked, what didn't)</label>
          <textarea name="shield_notes" placeholder="Which shields held? Which need adjusting?"></textarea>
        </div>
        <div class="form-group">
          <label>Notes</label>
          <textarea name="notes" placeholder="What progressed? What carries forward?"></textarea>
        </div>
        <button type="submit" class="btn">Save Review</button>
      </form>
    </div>

    <!-- QUOTE FOOTER -->
    <div class="quote-section" id="quoteSection">
      <div class="quote-text" id="quoteText"></div>
      <div class="quote-source" id="quoteSource"></div>
    </div>

  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script>
    // Toggle progress
    document.querySelectorAll('.toggle-card, .salah-card, .learning-block').forEach(card => {
      card.addEventListener('click', async () => {
        const field = card.dataset.field;
        if (!field) return;
        const isChecked = card.classList.contains('checked') || card.classList.contains('done');
        const newValue = !isChecked;
        
        try {
          const res = await fetch('/api/progress', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ field, value: newValue })
          });
          if (res.ok) {
            if (card.classList.contains('salah-card')) {
              card.classList.toggle('checked');
            } else if (card.classList.contains('learning-block')) {
              card.classList.toggle('done');
            } else {
              card.classList.toggle('checked');
            }
            checkSalahComplete();
            updateLearningTotal();
            showToast('✓ Updated');
          }
        } catch (err) {
          showToast('✗ Error', true);
        }
      });
    });

    function checkSalahComplete() {
      const prayers = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];
      const allChecked = prayers.every(p => document.querySelector(`.salah-card[data-field="${p}"]`).classList.contains('checked'));
      document.getElementById('salahBanner').classList.toggle('show', allChecked);
    }

    function updateLearningTotal() {
      const blocks = ['block1_done', 'block2_done', 'block3_done', 'block4_done'];
      const done = blocks.filter(b => document.querySelector(`.learning-block[data-field="${b}"]`).classList.contains('done')).length;
      const total = document.getElementById('learningTotal');
      if (done === 4) {
        total.textContent = '🎉 All 4 blocks done! 6 hours complete! 🔥';
        total.style.color = 'var(--emerald)';
      } else {
        total.textContent = `${done}/4 blocks done`;
      }
    }

    checkSalahComplete();
    updateLearningTotal();

    // DSA form
    document.getElementById('dsaForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      try {
        const res = await fetch('/api/dsa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          showToast('✓ Problem logged!');
          e.target.reset();
        }
      } catch (err) {
        showToast('✗ Error', true);
      }
    });

    // Journal save
    async function saveJournal() {
      const entries = [
        { entry_type: 'three_wins', content: document.getElementById('journal_wins').value },
        { entry_type: 'three_targets', content: document.getElementById('journal_targets').value },
        { entry_type: 'brain_dump', content: document.getElementById('journal_braindump').value }
      ];
      for (const entry of entries) {
        if (entry.content.trim()) {
          try {
            await fetch('/api/journal', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(entry)
            });
          } catch (err) { }
        }
      }
      showToast('✓ Journal saved!');
    }

    // Weekly review form
    document.getElementById('reviewForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      try {
        const res = await fetch('/api/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) showToast('✓ Review saved!');
      } catch (err) {
        showToast('✗ Error', true);
      }
    });

    // Toast
    function showToast(msg, isError) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.className = 'toast show' + (isError ? ' error' : '');
      setTimeout(() => toast.className = 'toast' + (isError ? ' error' : ''), 2000);
    }

    // Rotating quotes
    const quotes = [
      { text: "The best of sinners are those who repent often.", source: "Prophet Muhammad ﷺ (Tirmidhi)" },
      { text: "Allah is more delighted with the repentance of His servant than one of you who finds his lost camel in the desert.", source: "Prophet Muhammad ﷺ (Bukhari)" },
      { text: "Whoever prays the two cool prayers (Fajr and Asr) will enter Paradise.", source: "Prophet Muhammad ﷺ (Bukhari)" },
      { text: "Take on only as much as you can do well, for Allah does not tire until you tire.", source: "Prophet Muhammad ﷺ (Bukhari)" },
      { text: "The most beloved deeds to Allah are those done consistently, even if small.", source: "Prophet Muhammad ﷺ (Bukhari)" },
      { text: "When a man sleeps, Satan ties three knots at the back of his head. But when he wakes and mentions Allah, one knot is untied.", source: "Prophet Muhammad ﷺ (Bukhari)" },
      { text: "Between a man and shirk and kufr is the abandonment of prayer.", source: "Prophet Muhammad ﷺ (Muslim)" },
      { text: "There is no creature on earth but that upon Allah is its provision.", source: "Quran 11:6" },
      { text: "And whoever fears Allah — He will make a way for him to exit. And He will provide for him from where he does not expect.", source: "Quran 65:2-3" },
      { text: "Indeed, Allah will not change the condition of a people until they change what is in themselves.", source: "Quran 13:11" },
      { text: "The strong believer is better and more beloved to Allah than the weak believer, though in both there is good.", source: "Prophet Muhammad ﷺ (Muslim)" },
      { text: "Strive for that which benefits you, and seek Allah's help, and do not despair.", source: "Prophet Muhammad ﷺ (Muslim)" },
      { text: "You are at 1% of your potential. The salah is the lever that unlocks the other 99%.", source: "Your Mentor" },
      { text: "Every LeetCode problem is an act of walking away from riba.", source: "Your Mentor" },
    ];

    const dayOfYear = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);
    const quote = quotes[dayOfYear % quotes.length];
    document.getElementById('quoteText').textContent = '"' + quote.text + '"';
    document.getElementById('quoteSource').textContent = '— ' + quote.source;
  </script>
</body>
