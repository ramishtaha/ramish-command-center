            <span class="tc-icon">💧</span>
            <span class="tc-label">Sleep on Wudu</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Rest in purity</div>
        </div>
        <div class="toggle-card" data-field="evening_reset" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.evening_reset %>">
          <div class="tc-head">
            <span class="tc-icon">✅</span>
