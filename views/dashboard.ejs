<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Command Center · Day <%= dayNumber %> of 84</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- ============================== 1. HERO SECTION ============================== -->
  <header class="app-header hero-header">
    <div class="container">
      <div class="row row-wrap" style="justify-content:space-between;">
        <div>
          <div class="greeting">Bismillah, <span class="accent"><%= user.username %></span> 🌙</div>
          <div class="date-line">
            <%= today.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
          </div>
        </div>
        <div class="row" style="gap:10px;">
          <% if (todayProgress.mode_used) { %>
            <span class="mode-badge"><%= todayProgress.mode_used === 'office' ? '🏢 Office' : '🏠 Laptop' %></span>
          <% } %>
          <a class="logout-link" href="/logout">Sign out</a>
        </div>
      </div>

      <!-- Day progress + big streak + bar hit + DSA -->
      <div class="hero-row mt">
        <!-- Day of 84 -->
        <div class="hero-block hero-block--wide">
          <div class="progress-label">
            <span>Day <%= activeDayCount %> of 84</span>
            <span class="pct"><%= Math.round((activeDayCount / 84) * 100) %>%</span>
          </div>
          <div class="progress-wrap">
            <div class="progress-bar" style="width:<%= Math.min(100, (activeDayCount / 84) * 100) %>%"></div>
          </div>
        </div>

        <!-- Big streak badge -->
        <div class="hero-block">
          <div class="hero-stat">
            <span class="hero-stat-num"><%= salahStreak %></span>
            <span class="hero-stat-label">🔥 Day Streak</span>
          </div>
        </div>

        <!-- Bar hit today -->
        <div class="hero-block">
          <div class="hero-stat">
            <span class="hero-stat-num bar-emoji">
              <% if (todayProgress.bar_hit === 'high') { %>🟡<% } else if (todayProgress.bar_hit === 'low') { %>🟢<% } else { %>—<% } %>
            </span>
            <span class="hero-stat-label">Bar Today</span>
          </div>
        </div>

        <!-- DSA total + unaided % -->
        <div class="hero-block">
          <div class="hero-stat">
            <span class="hero-stat-num"><%= dsaCount %></span>
            <span class="hero-stat-label">💻 DSA Total</span>
          </div>
          <div class="unaided-mini-badge">
            Unaided <strong><%= (dsaUnaided && dsaUnaided.percent != null) ? dsaUnaided.percent : 0 %>%</strong>
          </div>
        </div>
      </div>

      <!-- Streak badges -->
      <div class="streak-badges header-streaks">
        <span class="streak-badge salah">
          <span class="fire">🔥</span> Salah · <%= salahStreak %>
        </span>
        <span class="streak-badge dsa">
          <span class="fire">🔥</span> DSA · <%= dsaStreak %>
        </span>
        <span class="streak-badge survival">
          <span class="fire">🔥</span> Survival · <%= survivalStreak %>
        </span>
      </div>

      <!-- Week stats -->
      <div class="week-stats mt">
        <div class="week-stat">
          <div class="ws-num"><%= weekStats.salah_complete_days %></div>
          <div class="ws-label">Salah Days</div>
        </div>
        <div class="week-stat">
          <div class="ws-num"><%= weekStats.dsa_days %></div>
          <div class="ws-label">DSA Days</div>
        </div>
        <div class="week-stat">
          <div class="ws-num"><%= weekStats.mma_days %></div>
          <div class="ws-label">MMA Days</div>
        </div>
        <div class="week-stat">
          <div class="ws-num"><%= weekStats.survival_days %></div>
          <div class="ws-label">Survival Days</div>
        </div>
        <div class="week-stat">
          <div class="ws-num"><%= weekStats.total_days %></div>
          <div class="ws-label">Total /7</div>
        </div>
      </div>

      <% if (weekStats.low_bar_days != null || weekStats.high_bar_days != null) { %>
      <div class="bar-stats mt">
        <% if (weekStats.low_bar_days != null) { %>
        <span class="bar-pill bar-pill--low">🟢 Low Bar: <%= weekStats.low_bar_days %>/7</span>
        <% } %>
        <% if (weekStats.high_bar_days != null) { %>
        <span class="bar-pill bar-pill--high">🟡 High Bar: <%= weekStats.high_bar_days %>/7</span>
        <% } %>
      </div>
      <% } %>
    </div>
  </header>

  <main class="container">

    <!-- ============================== 2. TRAJECTORY & PROJECTION ============================== -->
    <% if (projection) { %>
    <section class="section" id="trajectory">
      <div class="section-title">
        <span class="icon">📈</span> Trajectory &amp; Projection
        <span class="hint">Where you're heading</span>
      </div>
      <div class="grid cols-2">
        <!-- Pace -->
        <div class="card proj-card">
          <div class="proj-label">At your current pace</div>
          <div class="proj-value"><%= projection.pace %> <span class="proj-unit">problems/day</span></div>
          <div class="proj-sub">Days remaining: <strong><%= projection.daysRemaining %></strong></div>
        </div>

        <!-- Projected completion -->
        <div class="card proj-card">
          <div class="proj-label">Projected completion</div>
          <div class="proj-value">Day <%= projection.projectedFinishDays %> of 84</div>
          <div class="progress-wrap proj-progress">
            <div class="progress-bar" style="width:<%= Math.min(100, (projection.projectedFinishDays / 84) * 100) %>%"></div>
          </div>
        </div>

        <!-- Rest day budget -->
        <div class="card proj-card <%= projection.restBudget < 0 ? 'proj-card--danger' : 'proj-card--ok' %>">
          <div class="proj-label">Rest day budget</div>
          <div class="proj-value">
            <%= projection.restBudget >= 0 ? projection.restBudget + ' days available' : Math.abs(projection.restBudget) + ' days over' %>
          </div>
          <div class="proj-sub">
            <%= projection.restBudget >= 0 ? '✅ On track — you have buffer' : '⚠️ You\'re behind — no rest left' %>
          </div>
        </div>

        <!-- Need to speed up? -->
        <div class="card proj-card <%= projection.needToSpeedUp ? 'proj-card--danger' : 'proj-card--ok' %>">
          <div class="proj-label">Need to speed up?</div>
          <div class="proj-value proj-value--big">
            <%= projection.needToSpeedUp ? '⚠️ Yes' : '✅ No' %>
          </div>
          <div class="proj-sub">
            <%= projection.needToSpeedUp ? 'Increase your daily pace to stay on track' : 'You\'re on pace — keep going!' %>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <!-- ============================== 3. TODAY'S PLAN ============================== -->
    <% if (todayPlan) { %>
    <section class="section" id="today-plan">
      <div class="section-title">
        <span class="icon">🎯</span> Today's Plan
        <span class="hint">What to tackle today</span>
      </div>

      <div class="plan-grid">
        <!-- DSA -->
        <% if (todayPlan.dsa && todayPlan.dsa.length) { %>
        <div class="plan-card">
          <div class="plan-card-head">
            <span class="plan-icon">💻</span>
            <span class="plan-title">DSA</span>
            <span class="plan-bar">🟢 Low: log 1 · 🟡 High: log 2+</span>
          </div>
          <div class="plan-items">
            <% todayPlan.dsa.forEach(function(prob, i){ %>
              <div class="plan-item">
                <span class="plan-check">☐</span>
                <span class="plan-text"><%= prob %></span>
              </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Spring Boot -->
        <% if (todayPlan.spring_boot) { %>
        <div class="plan-card">
          <div class="plan-card-head">
            <span class="plan-icon">🌱</span>
            <span class="plan-title">Spring Boot</span>
            <span class="plan-bar">🟢 Low: 1 commit · 🟡 High: feature done</span>
          </div>
          <div class="plan-items">
            <div class="plan-item">
              <span class="plan-check">☐</span>
              <span class="plan-text"><%= todayPlan.spring_boot %></span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- System Design -->
        <% if (todayPlan.system_design) { %>
        <div class="plan-card">
          <div class="plan-card-head">
            <span class="plan-icon">🏗️</span>
            <span class="plan-title">System Design</span>
            <span class="plan-bar">🟢 Low: read · 🟡 High: diagram</span>
          </div>
          <div class="plan-items">
            <div class="plan-item">
              <span class="plan-check">☐</span>
              <span class="plan-text"><%= todayPlan.system_design %></span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Career -->
        <% if (todayPlan.career) { %>
        <div class="plan-card">
          <div class="plan-card-head">
            <span class="plan-icon">🚀</span>
            <span class="plan-title">Career</span>
            <span class="plan-bar">🟢 Low: 1 action · 🟡 High: apply</span>
          </div>
          <div class="plan-items">
            <div class="plan-item">
              <span class="plan-check">☐</span>
              <span class="plan-text"><%= todayPlan.career %></span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- DevOps -->
        <% if (todayPlan.devops) { %>
        <div class="plan-card">
          <div class="plan-card-head">
            <span class="plan-icon">⚙️</span>
            <span class="plan-title">DevOps</span>
            <span class="plan-bar">🟢 Low: learn · 🟡 High: deploy</span>
          </div>
          <div class="plan-items">
            <div class="plan-item">
              <span class="plan-check">☐</span>
              <span class="plan-text"><%= todayPlan.devops %></span>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <!-- ============================== 4. OVERDUE & PENDING ============================== -->
    <% if ((overdueRevisions && overdueRevisions.length) || (unaidedQueue && unaidedQueue.length)) { %>
    <section class="section overdue-section" id="overdue">
      <div class="section-title">
        <span class="icon">⚠️</span> Overdue &amp; Pending
        <span class="hint">Handle these first</span>
      </div>

      <% if (overdueRevisions && overdueRevisions.length) { %>
      <div class="card overdue-card">
        <div class="card-title overdue-title">📅 Overdue Revisions</div>
        <div class="overdue-list">
          <% overdueRevisions.forEach(function(rev){ %>
            <div class="overdue-item">
              <div class="overdue-problem"><%= rev.problem %></div>
              <div class="overdue-meta">
                Solved: <%= new Date(rev.solved_date).toLocaleDateString('en-US', { month:'short', day:'numeric' }) %>
                · <span class="overdue-days"><%= rev.days_overdue %>d overdue</span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (unaidedQueue && unaidedQueue.length) { %>
      <div class="card overdue-card mt">
        <div class="card-title overdue-title">🔁 Unaided Re-Solve Queue</div>
        <div class="overdue-list">
          <% unaidedQueue.forEach(function(item){ %>
            <div class="overdue-item">
              <div class="overdue-problem"><%= item.problem %></div>
              <div class="overdue-meta">
                Re-solve without help
                <% if (item.help_level) { %>
                  · <span class="hl-badge hl-badge--<%= item.help_level %>"><%= item.help_level %></span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </section>
    <% } %>

    <!-- ============================== 5. SURVIVAL LAYER ============================== -->
    <section class="section" id="survival">
      <div class="section-title">
        <span class="icon">🌅</span> Survival Layer
        <span class="hint">Win the first hour, win the day</span>
      </div>
      <div class="grid cols-3">
        <div class="toggle-card" data-field="survival_layer" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.survival_layer %>">
          <div class="tc-head">
            <span class="tc-icon">⏰</span>
            <span class="tc-label">Alarm &amp; Out of Bed</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Wake on first alarm</div>
        </div>
        <div class="toggle-card" data-field="survival_layer" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.survival_layer %>">
          <div class="tc-head">
            <span class="tc-icon">🪥</span>
            <span class="tc-label">Brush Teeth</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Mouth fresh first thing</div>
        </div>
        <div class="toggle-card" data-field="survival_layer" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.survival_layer %>">
          <div class="tc-head">
            <span class="tc-icon">💧</span>
            <span class="tc-label">Wudu</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Begin in purity</div>
        </div>
        <div class="toggle-card" data-field="tahajjud" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.tahajjud %>">
          <div class="tc-head">
            <span class="tc-icon">🌌</span>
            <span class="tc-label">Tahajjud</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Night prayer</div>
        </div>
        <div class="toggle-card" data-field="fajr" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.fajr %>">
          <div class="tc-head">
            <span class="tc-icon">🕌</span>
            <span class="tc-label">Fajr on Time</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">First salah of the day</div>
        </div>
        <div class="toggle-card" data-field="duha" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.duha %>">
          <div class="tc-head">
            <span class="tc-icon">☀️</span>
            <span class="tc-label">Adhkar &amp; Duha</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Morning remembrance</div>
        </div>
        <div class="toggle-card" data-field="fasting" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.fasting %>">
          <div class="tc-head">
            <span class="tc-icon">🌑</span>
            <span class="tc-label">Fasting (Sunnah)</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Mon / Thu sunnah fast</div>
        </div>
      </div>
    </section>

    <!-- ============================== 6. SALAH TRACKER ============================== -->
    <section class="section" id="salah">
      <div class="section-title">
        <span class="icon">🕌</span> Salah Tracker
        <span class="hint">🔥 Salah streak · <%= salahStreak %> day<%= salahStreak === 1 ? '' : 's' %></span>
      </div>

      <div class="celebrate" id="salah-celebrate">
        <span class="emoji">🎉</span>
        <span>All 5 prayers complete! MashaAllah — keep the streak alive!</span>
      </div>

      <div class="grid cols-4">
        <div class="toggle-card" data-field="fajr" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.fajr %>">
          <div class="tc-head">
            <span class="tc-icon">🌅</span>
            <span class="tc-label">Fajr</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Dawn</div>
        </div>
        <div class="toggle-card" data-field="dhuhr" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.dhuhr %>">
          <div class="tc-head">
            <span class="tc-icon">🌞</span>
            <span class="tc-label">Dhuhr</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Noon</div>
        </div>
        <div class="toggle-card" data-field="asr" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.asr %>">
          <div class="tc-head">
            <span class="tc-icon">🌇</span>
            <span class="tc-label">Asr</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Afternoon</div>
        </div>
        <div class="toggle-card" data-field="maghrib" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.maghrib %>">
          <div class="tc-head">
            <span class="tc-icon">🌆</span>
            <span class="tc-label">Maghrib</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Sunset</div>
        </div>
        <div class="toggle-card" data-field="isha" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.isha %>">
          <div class="tc-head">
            <span class="tc-icon">🌙</span>
            <span class="tc-label">Isha</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Night</div>
        </div>
        <% if (today.getDay() === 5) { %>
        <div class="toggle-card" data-field="jumuah" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.jumuah %>">
          <div class="tc-head">
            <span class="tc-icon">🕋</span>
            <span class="tc-label">Jumu'ah</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Friday congregation</div>
        </div>
        <% } %>
      </div>
    </section>

    <!-- ============================== 7. PRIME LAYER ============================== -->
    <section class="section" id="prime">
      <div class="section-title">
        <span class="icon">📖</span> Prime Layer
        <span class="hint">Sharpen the mind &amp; the home</span>
      </div>
      <div class="grid cols-3">
        <div class="toggle-card" data-field="morning_reading" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.morning_reading %>">
          <div class="tc-head">
            <span class="tc-icon">📚</span>
            <span class="tc-label">Morning Reading</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Feed the mind early</div>
        </div>
        <div class="toggle-card" data-field="targets_set" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.targets_set %>">
          <div class="tc-head">
            <span class="tc-icon">🎯</span>
            <span class="tc-label">Targets Set</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Know today's wins</div>
        </div>
        <div class="toggle-card" data-field="house_task" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.house_task %>">
          <div class="tc-head">
            <span class="tc-icon">🏠</span>
            <span class="tc-label">House Task</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Serve the home</div>
        </div>
      </div>
    </section>

    <!-- ============================== 8. TRAINING ============================== -->
    <section class="section" id="training">
      <div class="section-title">
        <span class="icon">🥊</span> Training
        <span class="hint">Body &amp; discipline</span>
      </div>
      <div class="grid cols-3">
        <div class="toggle-card" data-field="mma" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.mma %>">
          <div class="tc-head">
            <span class="tc-icon">🥊</span>
            <span class="tc-label">MMA Session</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Train hard, stay sharp</div>
        </div>
        <div class="toggle-card" data-field="post_workout_meal" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.post_workout_meal %>">
          <div class="tc-head">
            <span class="tc-icon">🍗</span>
            <span class="tc-label">Post-Workout Meal</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Refuel properly</div>
        </div>
        <div class="toggle-card" data-field="shower" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.shower %>">
          <div class="tc-head">
            <span class="tc-icon">🚿</span>
            <span class="tc-label">Shower</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Clean &amp; fresh</div>
        </div>
      </div>
    </section>

    <!-- ============================== 9. LEARNING BLOCKS ============================== -->
    <section class="section" id="blocks">
      <div class="section-title">
        <span class="icon">🧠</span> Learning Blocks
        <span class="hint">6 hours total · TCS → GCC</span>
      </div>
      <div class="grid cols-4">
        <div class="toggle-card" data-field="block1_done" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.block1_done %>">
          <div class="tc-head">
            <span class="tc-icon">🟢</span>
            <span class="tc-label">Block 1 · DSA</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">~1.5h problems</div>
        </div>
        <div class="toggle-card" data-field="block2_done" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.block2_done %>">
          <div class="tc-head">
            <span class="tc-icon">🔵</span>
            <span class="tc-label">Block 2 · Spring Boot</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">~1.5h build</div>
        </div>
        <div class="toggle-card" data-field="block3_done" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.block3_done %>">
          <div class="tc-head">
            <span class="tc-icon">🟣</span>
            <span class="tc-label">Block 3 · System Design</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">~1.5h theory</div>
        </div>
        <div class="toggle-card" data-field="block4_done" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.block4_done %>">
          <div class="tc-head">
            <span class="tc-icon">🟡</span>
            <span class="tc-label">Block 4 · Revision</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">~1.5h review</div>
        </div>
      </div>
      <div class="stat-pills mt">
        <div class="stat-pill"><strong id="blocks-done">0</strong>/4 blocks done · <strong>6h</strong> total target</div>
      </div>
    </section>

    <!-- ============================== 10. SHIELDS ============================== -->
    <section class="section" id="shields">
      <div class="section-title">
        <span class="icon">🛡️</span> Shields
        <span class="hint">Protect the day, every day</span>
      </div>
      <div class="grid cols-3">
        <div class="toggle-card" data-field="ghusl_rule" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.ghusl_rule %>">
          <div class="tc-head">
            <span class="tc-icon">🛡️</span>
            <span class="tc-label">Ghusl Rule</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Purification maintained</div>
        </div>
        <div class="toggle-card" data-field="khalwah_shield" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.khalwah_shield %>">
          <div class="tc-head">
            <span class="tc-icon">🛡️</span>
            <span class="tc-label">Khalwah Shield</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Boundaries kept</div>
        </div>
        <div class="toggle-card" data-field="night_protocol" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.night_protocol %>">
          <div class="tc-head">
            <span class="tc-icon">🛡️</span>
            <span class="tc-label">Night Protocol</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Evening guard up</div>
        </div>
        <div class="toggle-card" data-field="phone_out_of_bedroom" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.phone_out_of_bedroom %>">
          <div class="tc-head">
            <span class="tc-icon">🛡️</span>
            <span class="tc-label">Phone Out of Bedroom</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Sleep without screens</div>
        </div>
        <div class="toggle-card" data-field="lower_gaze" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.lower_gaze %>">
          <div class="tc-head">
            <span class="tc-icon">🛡️</span>
            <span class="tc-label">Lower Gaze</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Guard the eyes</div>
        </div>
        <div class="toggle-card" data-field="no_new_riba" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.no_new_riba %>">
          <div class="tc-head">
            <span class="tc-icon">🛡️</span>
            <span class="tc-label">No New Riba</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Stay halal in finance</div>
        </div>
      </div>
    </section>

    <!-- ============================== 11. EVENING RESET ============================== -->
    <section class="section" id="evening">
      <div class="section-title">
        <span class="icon">🌙</span> Evening Reset
        <span class="hint">Close the day cleanly</span>
      </div>
      <div class="grid cols-3">
        <div class="toggle-card" data-field="haldi_doodh" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.haldi_doodh %>">
          <div class="tc-head">
            <span class="tc-icon">🥛</span>
            <span class="tc-label">Haldi Doodh</span>
            <span class="tc-check"></span>
          </div>
          <div class="tc-sub">Golden milk before bed</div>
        </div>
        <div class="toggle-card" data-field="sleep_on_wudu" tabindex="0" role="checkbox" aria-checked="<%= !!todayProgress.sleep_on_wudu %>">
