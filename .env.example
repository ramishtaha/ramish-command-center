# Environment variables for Ramish's Command Center
# Copy this file to .env and fill in real values
# DO NOT commit .env to git (it's in .gitignore)

# Heroku API key — get from https://dashboard.heroku.com/account (Account Settings → API Keys)
# Used by the Heroku CLI for deployment commands
HEROKU_API_KEY=HRKU-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PostgreSQL database URL
# On Heroku: auto-set when you run `heroku addons:create heroku-postgresql:essential-0`
# Local: postgresql://postgres:postgres@localhost:5432/ramish_command_center
DATABASE_URL=postgresql://username:password@host:5432/database

# Express session secret — any random string
# Generate one: openssl rand -hex 32
SESSION_SECRET=your-random-session-secret-here

# API key for Hermes Agent sync
# Used to authenticate requests to /api/sync and /api/sync/update
# Set this to match the API_KEY config var on Heroku
API_KEY=hermes-sync-ramish-2026
